# Copy to `.env.local` (which is gitignored) in this same folder.
#
# Only VITE_-prefixed variables reach the browser. Vite inlines them at BUILD
# time, so you must restart `npm run dev` after changing this file.
#
# NEVER put the Supabase service_role key in here — anything in this file
# ships inside the JavaScript bundle and is readable by any visitor.

# Where the Flask API is running.
VITE_API_URL=http://localhost:5000

# Needed later, only when you add Supabase login to the React app.
# The anon key is designed to be public, but it relies on RLS being enabled.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
