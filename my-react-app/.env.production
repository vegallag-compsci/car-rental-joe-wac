# Used by `npm run build` (and so by Vercel). Committed on purpose: the API
# address isn't a secret, it ends up in the public JavaScript bundle anyway.
#
# NEVER put keys in this file. Only VITE_-prefixed variables reach the
# browser; anything else here is ignored by Vite.
#
# A VITE_API_URL set in the Vercel dashboard overrides this value.
VITE_API_URL=https://car-rental-joe-wac-5ebu.vercel.app
