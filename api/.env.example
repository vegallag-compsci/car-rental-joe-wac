# ---------------------------------------------------------------------------
# Copy this file to `.env` in the same folder and fill in the real values.
#   cp .env.example .env
#
# `.env` is gitignored. NEVER commit it.
# Find these values in Supabase: Project Settings -> API
# ---------------------------------------------------------------------------

# Your project URL, e.g. https://abcdefghijkl.supabase.co
SUPABASE_URL=

# The "anon" / "public" key. Safe to use from a server. RLS still applies.
SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# OPTIONAL — the "service_role" key.
#
# !! THIS KEY BYPASSES ALL ROW LEVEL SECURITY. !!
# It can read and delete every row in your database. Treat it like a root
# password: server-side only, never in the React app, never in git.
#
# Leave it blank unless you are building admin routes. The app runs fine
# without it; only endpoints that explicitly ask for the admin client fail.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Flask settings
# ---------------------------------------------------------------------------

# Where the React dev server runs. Used for the CORS allow-list.
# Comma-separated if you need more than one origin.
#
# Vite is pinned to 5173 (strictPort in vite.config.js), so it will refuse to
# start rather than quietly move to 5174 and break CORS. If you deliberately
# run it on another port, add that origin here too.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Google login (app/routes/auth.py)
#
# No Google keys go in this file. The Google Client ID and Secret live in
# Supabase -> Authentication -> Sign In / Providers -> Google. Flask only
# needs the two URLs below, and the defaults already work for local dev.
#
# One-time setup in the dashboards:
#   1. Supabase -> Authentication -> URL Configuration -> Redirect URLs:
#        add   http://localhost:5000/api/auth/callback
#      (that is API_URL + /api/auth/callback; add the deployed one later too)
#   2. Google Cloud Console -> Credentials -> your OAuth client ->
#      Authorized redirect URIs must contain
#        https://<your-project-ref>.supabase.co/auth/v1/callback
#      (Supabase shows this exact URL on its Google provider page.)
#   3. Optional but recommended: Supabase -> Sign In / Providers -> turn Email
#      OFF, so Google really is the only way to create an account. The anon
#      key is public, so anyone could otherwise sign up with email directly.
# ---------------------------------------------------------------------------

# Where browsers reach this Flask server. Supabase redirects back to
# {API_URL}/api/auth/callback, so it must match the Redirect URL above.
API_URL=http://localhost:5000

# Where the React app runs. Users land here after signing in.
FRONTEND_URL=http://localhost:5173

# Port for the Flask dev server.
PORT=5000

# "development" turns on debug mode and verbose errors. Use "production" live.
FLASK_ENV=development
